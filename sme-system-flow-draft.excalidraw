   "link": null,
   "locked": false,
   "fontSize": 14,
   "fontFamily": 1,
   "text": "\"Our Django app runs fine locally under docker-compose.\nDeployed to Kubernetes it cannot reach Postgres since we\nturned on TLS. Pod logs show SSL handshake failures and\nthe readiness probe keeps failing. Works with sslmode=disable.\"",
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "qPWJhpUhy7AjPwYx10lI",
   "originalText": "\"Our Django app runs fine locally under docker-compose.\nDeployed to Kubernetes it cannot reach Postgres since we\nturned on TLS. Pod logs show SSL handshake failures and\nthe readiness probe keeps failing. Works with sslmode=disable.\"",
   "lineHeight": 1.25,
   "autoResize": true
  },
